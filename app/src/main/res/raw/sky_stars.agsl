// The stars over the night's sky, added at full size over the clouds by SkyShaders from Android 13: sharp points of
// a pixel or two, many faint, a few bright and twinkling, each hidden as much as the clouds in front of it are thick,
// as SkyRenderer's frame says. Each pixel looks only into its own cell of two grids, so it stays cheap.

// 256 x 256 value noise, repeating: red is the noise
uniform shader noise;
// How far one sees through the clouds, grey, from SkyRenderer's frame: a pixel of the output at its place times the
// scale, down by the offset
uniform shader clouds;
uniform float2 cloudsScale;
uniform float cloudsOffset;
// The output in pixels, and the part of the 2:3 sky it shows: left, top, width, height, 0 to 1
uniform float2 size;
uniform float4 view;
uniform float time;
// How much of the sky the clouds cover, 0 to 1
uniform float coverage;
// Where the sun or the moon stands on the sky, 0 to 1, and which: 0 none, 1 the sun, 2 the moon
uniform float3 body;
uniform float stars;
// Where the clouds thin out down the output, 0 its top to 1 its bottom; from below 0, nowhere
uniform float2 clear;

const float MOON_RADIUS = 0.031;
// As SkyRenderer's: where the horizon lies down the 2:3 sky, and the angle a unit of its height spans
const float HORIZON = 0.45;
const float SPAN = 1.0;

float3 ray(float2 f) {
    float e = (HORIZON - f.y) * SPAN;
    float u = (f.x - 0.5) * 0.6667 * SPAN;
    return normalize(float3(u, sin(e), cos(e)));
}

float hash(float2 p) {
    return float(noise.eval(fract(floor(p) / 256.0) * 256.0 + 0.5).r);
}

float veil(float2 xy) {
    return clear.x < 0.0 ? 0.0 : smoothstep(clear.x, clear.y, xy.y / size.y);
}

// The light of a grid's star at a pixel of the whole sky's pixels: cells of the size, a star in as many of them as
// the share says, as bright as the power leaves its random brightness; its colour in rgb
float4 star(float2 px, float cell, float share, float power, float salt) {
    float2 c = floor(px / cell);
    float r = hash(c + float2(salt, 13.0));
    if (r > share) {
        return float4(0.0);
    }
    float g = hash(c + float2(91.0 + salt, 37.0));
    float k = r / share;
    float2 at = (c + float2(0.15 + 0.7 * g, 0.15 + 0.7 * fract(k * 7.31 + g * 3.7))) * cell;
    float bright = pow(fract(k * 13.17 + g * 5.3), power);
    // A point: its core a pixel across, the brightest a little wider with a faint glow round it
    float sigma2 = 0.28 + 0.5 * bright;
    float d2 = dot(px - at, px - at);
    float light = exp(-d2 / sigma2) + 0.06 * bright * exp(-sqrt(d2) / 2.2);
    float twinkle = 0.8 + 0.2 * sin(time * (1.3 + 3.0 * g) + 6.28 * k);
    float3 tint = mix(float3(0.78, 0.86, 1.0), float3(1.0, 0.88, 0.74), smoothstep(0.55, 1.0, g));
    return float4(tint, 1.0) * (light * bright * mix(1.0, twinkle, bright));
}

half4 main(float2 xy) {
    // In the pixels of the whole sky, so the stars stand still as the view onto it is cut from another place
    float2 px = xy + view.xy * size / view.zw;
    // As big on any screen; on a small picture, as the cards' halved skies, no smaller than a pixel would allow
    float scale = clamp(size.x / 1080.0, 0.8, 2.0);
    float4 s = star(px / scale, 15.0, 0.42, 2.5, 0.0) * 1.1 + star(px / scale, 46.0, 0.6, 1.4, 57.0) * 1.8;
    if (s.w < 0.004) {
        return half4(0.0);
    }
    float2 f = view.xy + xy / size * view.zw;
    float3 rd = ray(f);
    // Under the texts, where the sky's clouds thin into their even colour, as much as that colour hides the night
    float thin = veil(xy);
    float seen = stars * smoothstep(0.02, 0.2, rd.y) * (1.0 - 0.5 * thin)
            * (1.0 - thin * smoothstep(0.35, 0.95, coverage));
    if (body.z > 1.5) {
        // None over the moon's disc
        float3 bd = ray(body.xy);
        seen *= smoothstep(MOON_RADIUS * 1.1, MOON_RADIUS * 1.4, length(rd - bd));
    }
    if (seen <= 0.0) {
        return half4(0.0);
    }
    float through = float(clouds.eval(float2(xy.x * cloudsScale.x, cloudsOffset + xy.y * cloudsScale.y)).r);
    float3 c = clamp(s.rgb * seen * through, 0.0, 1.0);
    return half4(half3(c), half(max(c.r, max(c.g, c.b))));
}
