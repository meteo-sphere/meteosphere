<?xml version="1.0" encoding="utf-8"?>
<!-- The sun tab: today's sun, the Sun now as SDO sees it and what comes next, then the year of sunrises and sunsets, the solstices and equinoxes, solar eclipses and signs, each folding away; the place and the moment are pinned over it on glass, added in the code -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvSun"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">
            <!-- Today's sun in a card of its own over the sky, under the place and the moment pinned over the tab -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_astro_hero"
                android:orientation="vertical"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">
                <org.meteosphere.ui.astro.SunDayChart
                    android:id="@+id/sunDayChart"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"/>
                <LinearLayout
                    android:id="@+id/llSunRiseSet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:padding="7dp"
                            android:background="@drawable/bg_magnitude"
                            android:backgroundTint="@color/astro_sun_container"
                            android:src="@drawable/ic_astro_sunrise"
                            android:tint="@color/astro_sun"
                            android:contentDescription="@null"/>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvSunRise"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                                android:textColor="?attr/colorOnSurface"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sunrise"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical|end"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="8dp"
                            android:gravity="end"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvSunSet"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                                android:textColor="?attr/colorOnSurface"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sunset"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"/>
                        </LinearLayout>
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:padding="7dp"
                            android:background="@drawable/bg_magnitude"
                            android:backgroundTint="@color/astro_sunset_container"
                            android:src="@drawable/ic_astro_sunset"
                            android:tint="@color/astro_sunset"
                            android:contentDescription="@null"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvSunPolar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_horizontal"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:visibility="gone"/>
            </LinearLayout>
            <!-- The Sun now, as SDO sees it -->
            <include android:id="@+id/cardSunNow" layout="@layout/item_sun_now"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <include android:id="@+id/tileDayLength" layout="@layout/item_astro_tile"/>
                <Space
                    android:id="@+id/spaceSunTiles"
                    android:layout_width="10dp"
                    android:layout_height="match_parent"/>
                <include android:id="@+id/tileSign" layout="@layout/item_astro_tile"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/llSunTiles2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <include android:id="@+id/tileNoon" layout="@layout/item_astro_tile"/>
                <Space
                    android:layout_width="10dp"
                    android:layout_height="match_parent"/>
                <include android:id="@+id/tileTwilight" layout="@layout/item_astro_tile"/>
            </LinearLayout>
            <include android:id="@+id/cardSunNext" layout="@layout/item_sun_next"/>
            <include android:id="@+id/headerSunYear" layout="@layout/item_astro_section"/>
            <LinearLayout
                android:id="@+id/llSunYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvSunSelectedDay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface"/>
                <org.meteosphere.ui.astro.SunYearChart
                    android:id="@+id/sunYearChart"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
            <include android:id="@+id/headerSunSeasons" layout="@layout/item_astro_section"/>
            <LinearLayout
                android:id="@+id/llSunSeasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
            <include android:id="@+id/headerSunEclipses" layout="@layout/item_astro_section"/>
            <LinearLayout
                android:id="@+id/llSunEclipses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
            <include android:id="@+id/headerSunSigns" layout="@layout/item_astro_section"/>
            <LinearLayout
                android:id="@+id/llSunSigns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
