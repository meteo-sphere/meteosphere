<?xml version="1.0" encoding="utf-8"?>
<!-- Settings of the earthquake, Sun and Moon widgets as the weather widgets': the preview on the home screen's
     wallpaper pinned on top, the location, the earthquakes' period and order, and the look in rounded groups scrolling
     under it -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_page"
    android:orientation="vertical">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        style="@style/Widget.Meteo.AppBarLayout"
        android:background="@color/settings_page">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/tbWidget"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"/>
    </com.google.android.material.appbar.AppBarLayout>
    <FrameLayout
        android:id="@+id/flWidgetSettings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <!-- As tall as the preview with its margins, set in code -->
                <org.meteosphere.ui.common.WallpaperWindowView
                    android:id="@+id/wallpaperWindow"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:importantForAccessibility="no"/>
                <FrameLayout
                    android:id="@+id/flQuakeWidgetPreview"
                    android:layout_width="match_parent"
                    android:layout_height="236dp"
                    android:layout_marginStart="@dimen/widget_margin"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="@dimen/widget_margin"
                    android:layout_marginBottom="16dp"/>
            </FrameLayout>
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false">
                <LinearLayout
                    android:id="@+id/llSettingsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/settings_list_margin"
                    android:paddingEnd="@dimen/settings_list_margin"
                    android:paddingBottom="@dimen/settings_list_bottom">
                    <TextView
                        style="@style/Widget.Meteo.WidgetSettingsGroup"
                        android:text="@string/place_title"/>
                    <include
                        android:id="@+id/llAutoPlace"
                        layout="@layout/widget_settings_row"/>
                    <include
                        android:id="@+id/llChosenPlace"
                        layout="@layout/widget_settings_row"/>
                    <TextView
                        style="@style/Widget.Meteo.WidgetSettingsGroup"
                        android:text="@string/earthquakes"/>
                    <include
                        android:id="@+id/llQuakePeriod"
                        layout="@layout/widget_settings_row"/>
                    <include
                        android:id="@+id/llQuakeShow"
                        layout="@layout/widget_settings_row"/>
                    <TextView
                        style="@style/Widget.Meteo.WidgetSettingsGroup"
                        android:text="@string/widget_settings_group_look"/>
                    <include
                        android:id="@+id/llGlass"
                        layout="@layout/widget_settings_row"/>
                    <include
                        android:id="@+id/llTransparency"
                        layout="@layout/widget_settings_slider_row"/>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
        <!-- The city search over the settings, on the screen's own background -->
        <FrameLayout
            android:id="@+id/flQuakeLocationSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/colorBackground"
            android:visibility="gone"/>
    </FrameLayout>
</LinearLayout>
