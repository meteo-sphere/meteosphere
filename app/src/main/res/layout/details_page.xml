<?xml version="1.0" encoding="utf-8"?>
<!-- A city's page of the details: the header and the cards scroll over the fixed sky; the pill of frosted glass stays
     on top -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.meteosphere.ui.details.DetailsScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="96dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="96dp">

            <!-- Not clipped to its padding: the big temperature's thin figures reach past its start; nor its texts to
                 their bounds, their shadows reaching past their ends -->
            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="20dp"
                android:paddingBottom="22dp">

                <TextView
                    android:id="@+id/tvCity"
                    style="@style/DetailsSkyHeaderText"
                    android:drawablePadding="8dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:textSize="30sp"
                    tools:text="Riga" />

                <!-- The wind now beside the temperature, in its empty end, no taller than it: an arrow where it blows
                     to, its speed, its unit and where it blows from, and a strong one marked -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-8dp"
                    android:clipChildren="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTemperature"
                        style="@style/DetailsSkyHeaderText"
                        android:fontFamily="sans-serif-thin"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.03"
                        android:textSize="112sp"
                        tools:text="10°" />

                    <LinearLayout
                        android:id="@+id/llWind"
                        android:layout_width="wrap_content"
                        android:clipChildren="false"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <!-- 26dp, padded for its shadow and pulled out by as much, so it takes the room it took -->
                        <ImageView
                            android:id="@+id/ivWindArrow"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_margin="-4dp"
                            android:padding="4dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_bearing" />

                        <TextView
                            android:id="@+id/tvWindSpeed"
                            style="@style/DetailsSkyHeaderText"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-light"
                            android:importantForAccessibility="no"
                            android:includeFontPadding="false"
                            android:textSize="38sp"
                            tools:text="3" />

                        <TextView
                            android:id="@+id/tvWindUnit"
                            style="@style/DetailsSkyHeaderText"
                            android:importantForAccessibility="no"
                            android:textSize="14sp"
                            tools:text="m/s, W" />

                        <TextView
                            android:id="@+id/tvWindStrong"
                            style="@style/DetailsSkyHeaderText"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_city_wind_strong"
                            android:fontFamily="sans-serif-medium"
                            android:importantForAccessibility="no"
                            android:paddingStart="7dp"
                            android:paddingTop="1dp"
                            android:paddingEnd="7dp"
                            android:paddingBottom="2dp"
                            android:text="@string/details_wind_strong_label"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCondition"
                    style="@style/DetailsSkyHeaderText"
                    android:layout_marginTop="2dp"
                    android:textSize="24sp"
                    tools:text="Overcast" />

                <TextView
                    android:id="@+id/tvHighLow"
                    style="@style/DetailsSkyHeaderText"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="16sp"
                    tools:text="↑ 15° / ↓ 9°" />

                <TextView
                    android:id="@+id/tvFeelsLike"
                    style="@style/DetailsSkyHeaderText"
                    android:layout_marginTop="2dp"
                    android:textSize="16sp"
                    tools:text="Feels like 9°" />

                <TextView
                    android:id="@+id/tvDate"
                    style="@style/DetailsSkyHeaderText"
                    android:layout_marginTop="2dp"
                    android:textSize="16sp"
                    tools:text="Sun, Oct 4, 10:25" />
            </LinearLayout>

            <!-- The forecast on its way, where the cards come -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/piForecast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="48dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/details_sky_text_dim" />

            <TextView
                android:id="@+id/tvNoData"
                style="@style/DetailsCard"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/no_data"
                android:textColor="@color/details_sky_text_dim"
                android:textSize="16sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/cardHourly"
                style="@style/DetailsCard">

                <TextView
                    android:id="@+id/tvSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="3dp"
                    android:paddingStart="@dimen/details_card_text_inset"
                    android:paddingTop="16dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="12dp"
                    android:textColor="@color/details_sky_text"
                    android:textSize="15sp"
                    tools:text="Overcast. Up to 15° in the afternoon. Wind SW, 3–4 m/s." />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/details_sky_divider" />

                <org.meteosphere.ui.details.ForecastStripView
                    android:id="@+id/stripHourly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="6dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardInsights"
                style="@style/DetailsCard">

                <org.meteosphere.ui.details.InsightsPager
                    android:id="@+id/pagerInsights"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <org.meteosphere.ui.details.PageDotsView
                    android:id="@+id/dotsInsights"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardDaily"
                style="@style/DetailsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/DetailsCardTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_details_calendar"
                        android:text="@string/details_daily_title" />

                    <TextView
                        android:id="@+id/tvDailyMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_details_button_ripple"
                        android:drawableEnd="@drawable/ic_expand_more"
                        android:drawablePadding="2dp"
                        android:drawableTint="@color/details_sky_text_dim"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="4dp"
                        android:text="@string/details_daily_more"
                        android:textColor="@color/details_sky_text_dim"
                        android:textSize="14sp" />
                </LinearLayout>

                <org.meteosphere.ui.details.DailyRangeView
                    android:id="@+id/dailyList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="20dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="2dp" />

                <org.meteosphere.ui.details.ForecastStripView
                    android:id="@+id/stripDaily"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:visibility="gone" />

</LinearLayout>

            <LinearLayout
                android:id="@+id/tiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- The Sun's glow at the top of the chart reaches over it -->
            <LinearLayout
                android:id="@+id/cardSun"
                style="@style/DetailsCard"
                android:clipChildren="false"
                android:foreground="@drawable/fg_details_card_ripple">

                <TextView
                    android:id="@+id/tvSunTitle"
                    style="@style/DetailsCardTitle"
                    android:drawableStart="@drawable/ic_widget_sun"
                    tools:text="Sun · day 11 h 17 min" />

                <org.meteosphere.ui.astro.SunDayChart
                    android:id="@+id/sunChart"
                    android:layout_width="match_parent"
                    android:layout_height="128dp"
                    android:layout_marginTop="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/DetailsSmallLabel"
                            android:text="@string/sunrise" />

                        <TextView
                            android:id="@+id/tvSunrise"
                            style="@style/DetailsTimeValue"
                            tools:text="07:33" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llTwilight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            style="@style/DetailsSmallLabel"
                            android:text="@string/sun_tile_twilight" />

                        <TextView
                            android:id="@+id/tvTwilight"
                            style="@style/DetailsTimeValue"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif"
                            android:textSize="15sp"
                            tools:text="07:00–19:23" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            style="@style/DetailsSmallLabel"
                            android:text="@string/sunset" />

                        <TextView
                            android:id="@+id/tvSunset"
                            style="@style/DetailsTimeValue"
                            tools:text="18:50" />
                    </LinearLayout>
                </LinearLayout>

                <!-- The Sun now as SDO sees it, under the day's: opens the pictures of the Sun -->
                <View
                    android:id="@+id/vSunNowDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:background="@color/details_sky_divider" />

                <LinearLayout
                    android:id="@+id/rowSunNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/fg_details_card_ripple"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/ivSunNowRow"
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/bg_sun_now_placeholder" />

                        <!-- A new picture loading: the viewer's ring, sized to the disc as on the sun tab -->
                        <org.meteosphere.ui.astro.LoadingRing
                            android:id="@+id/piSunNowRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:theme="@style/ThemeOverlay.Meteo.SunNow"
                            android:visibility="gone"
                            app:indicatorSize="28dp"
                            app:trackThickness="3dp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSunNowRowChannel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/details_sky_text"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvSunNowRowTime"
                            style="@style/DetailsSmallLabel"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/details_sky_text_dim" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardMoon"
                style="@style/DetailsCard"
                android:foreground="@drawable/fg_details_card_ripple"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <ImageView
                    android:id="@+id/ivMoon"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMoonPhase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/details_sky_text"
                        android:textSize="18sp"
                        tools:text="Waning crescent" />

                    <TextView
                        android:id="@+id/tvMoonInfo"
                        style="@style/DetailsSmallLabel"
                        android:layout_marginTop="2dp"
                        tools:text="Illuminated 42%\nNew moon in 6 days" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                style="@style/DetailsSmallLabel"
                                android:text="@string/moon_rise" />

                            <TextView
                                android:id="@+id/tvMoonrise"
                                style="@style/DetailsTimeValue"
                                android:textSize="20sp"
                                tools:text="23:55" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="28dp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/DetailsSmallLabel"
                                android:text="@string/moon_set" />

                            <TextView
                                android:id="@+id/tvMoonset"
                                style="@style/DetailsTimeValue"
                                android:textSize="20sp"
                                tools:text="17:11" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="28dp"
                android:paddingTop="4dp"
                android:paddingEnd="28dp">

                <TextView
                    android:id="@+id/tvSource"
                    style="@style/DetailsSmallLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    tools:text="Open-Meteo" />

                <TextView
                    android:id="@+id/tvUpdated"
                    style="@style/DetailsSmallLabel"
                    tools:text="Refreshed just now" />
            </LinearLayout>
        </LinearLayout>
    </org.meteosphere.ui.details.DetailsScrollView>

    <org.meteosphere.ui.glass.GlassPill
        android:id="@+id/pill"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="14dp"
        android:alpha="0"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:visibility="invisible">

        <TextView
            android:id="@+id/tvPillCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxWidth="200dp"
            android:singleLine="true"
            android:textColor="@color/details_sky_text"
            android:textSize="18sp"
            tools:text="Riga" />

        <ImageView
            android:id="@+id/ivPillIcon"
            android:layout_width="30dp"
            android:layout_height="22dp"
            android:layout_marginStart="10dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvPillTemperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/details_sky_text"
            android:textSize="18sp"
            tools:text="10°" />
    </org.meteosphere.ui.glass.GlassPill>
</FrameLayout>
