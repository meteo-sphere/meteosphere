<?xml version="1.0" encoding="utf-8"?>
<!-- A weather widget's settings as the app's: the preview on the home screen's wallpaper pinned on top, the settings in rounded
     groups scrolling under it -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_page"
    android:orientation="vertical">
    <!-- The preview pinned over the scrolling settings -->
    <FrameLayout
        android:id="@+id/flStageHolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/svWidgetSettings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">
        <LinearLayout
            android:id="@+id/llSettingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/settings_list_margin"
            android:paddingEnd="@dimen/settings_list_margin"
            android:paddingBottom="@dimen/settings_list_bottom">
            <TextView
                style="@style/Widget.Meteo.WidgetSettingsGroup"
                android:text="@string/place_title"/>
            <include
                android:id="@+id/llAutoPlace"
                layout="@layout/widget_settings_row"/>
            <include
                android:id="@+id/llChosenPlace"
                layout="@layout/widget_settings_row"/>
            <TextView
                style="@style/Widget.Meteo.WidgetSettingsGroup"
                android:text="@string/widget_settings_group_show"/>
            <include
                android:id="@+id/llShowNow"
                layout="@layout/widget_settings_row"/>
            <include
                android:id="@+id/llShowWind"
                layout="@layout/widget_settings_row"/>
            <include
                android:id="@+id/llShowPrecipitation"
                layout="@layout/widget_settings_row"/>
            <TextView
                style="@style/Widget.Meteo.WidgetSettingsGroup"
                android:text="@string/widget_settings_group_look"/>
            <include
                android:id="@+id/llGlass"
                layout="@layout/widget_settings_row"/>
            <include
                android:id="@+id/llTransparency"
                layout="@layout/widget_settings_slider_row"/>
            <TextView
                style="@style/Widget.Meteo.WidgetSettingsGroup"
                android:text="@string/widget_settings_group_clock"/>
            <include
                android:id="@+id/llClockApp"
                layout="@layout/widget_settings_row"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
