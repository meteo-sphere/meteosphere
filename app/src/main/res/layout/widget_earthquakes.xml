<?xml version="1.0" encoding="utf-8"?>
<!-- The earthquake widget: the period and the count, the location, then the earthquakes as rows added in code -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flQuakeWidget"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imvBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/widget_glass_inset"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_dark"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/imvQuakeIcon"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:src="@drawable/ic_stat_earthquake"/>
            <TextView
                android:id="@+id/tvQuakeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:singleLine="true"
                android:fontFamily="sans-serif-medium"
                android:textSize="15sp"/>
            <TextView
                android:id="@+id/tvQuakeLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:gravity="end"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="15sp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/llQuakeRows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"/>
        <TextView
            android:id="@+id/tvQuakeEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="14sp"
            android:visibility="gone"/>
    </LinearLayout>
</FrameLayout>
