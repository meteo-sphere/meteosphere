<?xml version="1.0" encoding="utf-8"?>
<!-- The Sun now on the sun tab: SDO's latest corona cut from its black sky, its name and when it was taken; opens the
     pictures of the Sun -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.CardView.Filled"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:clickable="true"
    android:focusable="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="7dp">
            <ImageView
                android:id="@+id/ivSunNow"
                android:layout_width="102dp"
                android:layout_height="102dp"
                android:scaleType="fitCenter"
                android:src="@drawable/bg_sun_now_placeholder"
                android:contentDescription="@null"/>
            <!-- A new picture loading: the viewer's ring -->
            <org.meteosphere.ui.astro.LoadingRing
                android:id="@+id/piSunNowCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:theme="@style/ThemeOverlay.Meteo.SunNow"
                android:visibility="gone"/>
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="7dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sun_now"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant"/>
            <TextView
                android:id="@+id/tvSunNowChannel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"/>
            <TextView
                android:id="@+id/tvSunNowTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/sun_now_loading"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"/>
        </LinearLayout>
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="12dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="?attr/colorOnSurfaceVariant"
            android:contentDescription="@null"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
