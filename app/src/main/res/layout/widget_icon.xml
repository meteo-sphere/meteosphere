<?xml version="1.0" encoding="utf-8"?>
<!-- The 1x1 weather widget: the weather icon in the room left, the temperature now or the day's lowest and highest
     under it, and the place's line at the bottom -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flWidget"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imvBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/widget_glass_inset"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="@dimen/widget_padding"
        android:paddingTop="@dimen/widget_padding"
        android:paddingRight="@dimen/widget_padding"
        android:paddingBottom="@dimen/widget_padding_bottom"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/imvIcon"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="center"/>
        <!-- The temperature now; by days the lowest with its "…", then the highest, centred together -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvTemperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textSize="@dimen/widget_icon_temperature"/>
            <TextView
                android:id="@+id/tvTemperatureHigh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textSize="@dimen/widget_icon_range"
                android:visibility="gone"/>
        </LinearLayout>
        <include layout="@layout/widget_place_line"/>
    </LinearLayout>
    <include layout="@layout/widget_settings_gear"/>
    <FrameLayout
        android:id="@+id/flRefresh"
        android:layout_width="@dimen/widget_refresh_area"
        android:layout_height="@dimen/widget_refresh_area"
        android:layout_gravity="bottom|left"
        android:background="@color/widget_tap_area"/>
</FrameLayout>
