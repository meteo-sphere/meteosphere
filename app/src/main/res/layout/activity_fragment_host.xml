<?xml version="1.0" encoding="utf-8"?>
<!-- A tab opened on its own: it fills the screen, the bar clear over its top, the content dissolving into the
     background under it and the tab's row of controls, see TopFadeBar; at the bottom the content runs under the
     navigation bar, fading out, over a shade on a dark tab, see FragmentHost -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.meteosphere.ui.common.BottomFadeFrame
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/flFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </org.meteosphere.ui.common.BottomFadeFrame>
    <org.meteosphere.ui.common.BottomScrimView
        android:id="@+id/bottomScrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:importantForAccessibility="no"/>
    <org.meteosphere.ui.glass.GlassStrip
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/tbFragment"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@null"/>
    </org.meteosphere.ui.glass.GlassStrip>
</FrameLayout>
