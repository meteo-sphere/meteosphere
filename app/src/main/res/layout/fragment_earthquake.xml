<?xml version="1.0" encoding="utf-8"?>
<!-- One earthquake: its magnitude and place on a card in the magnitude's color, a map of where it was, the tsunami,
     PAGER and felt reports, tiles of the time, depth, distance and scale, and the USGS page. Opaque and taking the
     touches, as it also lies over the list it was opened from -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clickable="true"
    android:orientation="vertical">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        style="@style/Widget.Meteo.AppBarLayout">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/tbEarthquake"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="@string/abc_action_bar_up_description"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="?attr/colorOnSurface"
            app:title="@string/earthquake_title"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/svEarthquake"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuakeHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView
                        android:id="@+id/tvQuakeMagnitude"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textSize="48sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tvQuakeScale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.8"
                        android:textAppearance="?attr/textAppearanceLabelMedium"/>
                    <TextView
                        android:id="@+id/tvQuakePlace"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textAppearance="?attr/textAppearanceTitleMedium"/>
                    <TextView
                        android:id="@+id/tvQuakeAgo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.8"
                        android:textAppearance="?attr/textAppearanceBodyMedium"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Where it was in the world, with the location of the list -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="16dp">
                <org.meteosphere.ui.quakes.QuakeMapView
                    android:id="@+id/quakeDetailMap"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"/>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgQuakeBadges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <include android:id="@+id/tileQuakeTime" layout="@layout/item_astro_tile"/>
                <Space
                    android:layout_width="10dp"
                    android:layout_height="match_parent"/>
                <include android:id="@+id/tileQuakeDepth" layout="@layout/item_astro_tile"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <include android:id="@+id/tileQuakeDistance" layout="@layout/item_astro_tile"/>
                <Space
                    android:id="@+id/spaceQuakeTiles"
                    android:layout_width="10dp"
                    android:layout_height="match_parent"/>
                <include android:id="@+id/tileQuakeScale" layout="@layout/item_astro_tile"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuakeUsgs"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/earthquake_open_usgs"
                app:icon="@drawable/ic_open_in_new"
                app:iconGravity="textStart"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
