<?xml version="1.0" encoding="utf-8"?>
<!-- The chart widgets, 4x2 and 4x3: the card ChartWidget draws, at the bottom under the clock or in the middle without
     it. The clock in its two forms: the date and the next alarm over the time, or the time in the middle of the width
     with the date in the room left of it and the alarm in the room right of it -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical">
    <FrameLayout
        android:id="@+id/flClock"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/llClockNormal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvClockDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/widget_clock_text"/>
                <ImageView
                    android:id="@+id/imvClockAlarm"
                    android:layout_width="@dimen/widget_clock_alarm_icon"
                    android:layout_height="@dimen/widget_clock_alarm_icon"
                    android:layout_marginLeft="@dimen/widget_clock_alarm_gap"
                    android:alpha="0.7"
                    android:src="@drawable/ic_widget_alarm"/>
                <TextView
                    android:id="@+id/tvClockAlarm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/widget_clock_alarm_text_gap"
                    android:singleLine="true"
                    android:textColor="#b3ffffff"
                    android:textSize="@dimen/widget_clock_text"/>
            </LinearLayout>
            <TextClock
                android:id="@+id/tcClockTime"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@android:color/white"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/llClockExtended"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/tvClockDate2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingRight="@dimen/widget_clock_beside_gap"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@android:color/white"
                android:textSize="@dimen/widget_clock_text"/>
            <TextClock
                android:id="@+id/tcClockTime2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@android:color/white"/>
            <LinearLayout
                android:id="@+id/llClockAlarm2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="@dimen/widget_clock_alarm_icon"
                    android:layout_height="@dimen/widget_clock_alarm_icon"
                    android:alpha="0.7"
                    android:src="@drawable/ic_widget_alarm"/>
                <TextView
                    android:id="@+id/tvClockAlarm2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/widget_clock_alarm_text_gap"
                    android:singleLine="true"
                    android:textColor="#b3ffffff"
                    android:textSize="@dimen/widget_clock_text"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <!-- The card's picture across the widget's whole width, unscaled where it fits, else shrunk to the widget keeping its
         proportions; centred by the views themselves, which round a half pixel the launcher's frame adds up -->
    <FrameLayout
        android:id="@+id/flCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/imvBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:visibility="gone"/>
        <ImageView
            android:id="@+id/imvChart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"/>
        <FrameLayout
            android:id="@+id/flSettings"
            android:layout_width="@dimen/widget_settings_area"
            android:layout_height="@dimen/widget_settings_area"
            android:layout_gravity="top|left"
            android:background="@color/widget_tap_area"
            android:visibility="gone"/>
        <FrameLayout
            android:id="@+id/flRefresh"
            android:layout_width="@dimen/widget_refresh_area"
            android:layout_height="@dimen/widget_refresh_area"
            android:layout_gravity="bottom|left"
            android:background="@color/widget_tap_area"/>
    </FrameLayout>
</LinearLayout>
