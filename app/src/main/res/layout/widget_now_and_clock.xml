<?xml version="1.0" encoding="utf-8"?>
<!-- The 4x2 weather now with the clock: the temperature now with the day's highest and lowest at the top left, the
     place's line and the wind under them, the icon at the top right, the date over the clock at the bottom right and
     the precipitation's sentence left of them. The code sets the sizes of the texts, the pictures and the gaps, all
     shrunk together where the widget is too small for them -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flWidget"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imvBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/widget_glass_inset"
        android:scaleType="fitXY"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="@dimen/widget_now_clock_padding"
        android:paddingTop="@dimen/widget_now_clock_padding"
        android:paddingRight="@dimen/widget_now_clock_padding"
        android:paddingBottom="@dimen/widget_padding_bottom">
        <LinearLayout
            android:id="@+id/llNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/llTemperatures"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvTemperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"/>
                <LinearLayout
                    android:id="@+id/llRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/imvHigh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:id="@+id/tvHigh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:singleLine="true"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/llLow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:id="@+id/imvLow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:id="@+id/tvLow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:singleLine="true"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/llPlace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <!-- As widget_place_line.xml's: the spinner held to the button's square -->
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/imvRefresh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.5"/>
                    <ProgressBar
                        android:id="@+id/pbRefresh"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignLeft="@id/imvRefresh"
                        android:layout_alignTop="@id/imvRefresh"
                        android:layout_alignRight="@id/imvRefresh"
                        android:layout_alignBottom="@id/imvRefresh"
                        android:minWidth="0dp"
                        android:maxWidth="1dp"
                        android:minHeight="0dp"
                        android:maxHeight="1dp"
                        android:visibility="gone"/>
                </RelativeLayout>
                <TextView
                    android:id="@+id/tvPlace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:singleLine="true"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/llWind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/imvWind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/tvWind"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/imvIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|right"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:baselineAligned="false"
            android:gravity="bottom|right"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvSentence"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"/>
            <LinearLayout
                android:id="@+id/llClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="right"
                android:orientation="vertical">
                <TextClock
                    android:id="@+id/tcDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"/>
                <TextClock
                    android:id="@+id/tcTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:singleLine="true"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <!-- The refresh's tap over the start of the place's line, put there by the top padding of this frame -->
    <FrameLayout
        android:id="@+id/flRefreshHolder"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/flRefresh"
            android:layout_width="@dimen/widget_now_clock_refresh_area"
            android:layout_height="wrap_content"
            android:background="@color/widget_tap_area"/>
    </FrameLayout>
    <include layout="@layout/widget_settings_gear"/>
</FrameLayout>
