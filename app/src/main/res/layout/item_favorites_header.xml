<?xml version="1.0" encoding="utf-8"?>
<!-- A section's title over the favourites' cards, its text at the bottom; FavoritesFragment gives it its text,
     and half the height with none over the current location -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/favorites_header_height"
    android:gravity="bottom|start"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp"
    android:textAppearance="?attr/textAppearanceTitleSmall"
    android:textColor="?attr/colorPrimary"
    tools:text="My locations" />
