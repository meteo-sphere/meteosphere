<?xml version="1.0" encoding="utf-8"?>
<!-- The nearest town as a card of its own sky: you are here, its name and temperature, its weather on the right -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <FrameLayout
        android:id="@+id/nearbyHero"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nearby_hero_height"
        android:background="@drawable/bg_city_card"
        android:foreground="@drawable/fg_details_card_ripple">

        <ImageView
            android:id="@+id/ivHeroSky"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_city_card_shade" />

        <ImageView
            android:id="@+id/ivHeroIcon"
            android:layout_width="88dp"
            android:layout_height="66dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <!-- Its texts' shadows not cut at their ends: within its padding -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvHeroHere"
                style="@style/DetailsSkyHeaderText"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:text="@string/nearby_you_are_here"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvHeroName"
                style="@style/DetailsSkyHeaderText"
                android:layout_width="match_parent"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="96dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textSize="24sp"
                tools:text="Moscow" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:clipChildren="false"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvHeroTemperature"
                    style="@style/DetailsSkyHeaderText"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="72sp"
                    tools:text="+9°" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHeroCondition"
                        style="@style/DetailsSkyHeaderText"
                        android:gravity="end"
                        android:maxLines="2"
                        android:textSize="14sp"
                        tools:text="Overcast" />

                    <!-- The wind with its icon, shadowed as the other texts on the sky, ending where the weather does; a
                         strong one on a red pill, padded at its sides in the code -->
                    <TextView
                        android:id="@+id/tvHeroWind"
                        style="@style/DetailsSkyHeaderText"
                        android:layout_marginTop="4dp"
                        android:drawableStart="@drawable/ic_city_wind"
                        android:drawablePadding="4dp"
                        android:gravity="center"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:singleLine="true"
                        android:textSize="14sp"
                        tools:text="3 m/s" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
