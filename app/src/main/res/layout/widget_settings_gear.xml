<?xml version="1.0" encoding="utf-8"?>
<!-- Before Android 12 a weather widget's gear at the top left, and the tap over it that opens its settings; the code
     shows them there only -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:id="@+id/imvSettings"
        android:layout_width="@dimen/widget_settings_icon"
        android:layout_height="@dimen/widget_settings_icon"
        android:layout_gravity="top|left"
        android:layout_margin="@dimen/widget_settings_margin"
        android:alpha="0.3"
        android:visibility="gone"/>
    <FrameLayout
        android:id="@+id/flSettings"
        android:layout_width="@dimen/widget_settings_area"
        android:layout_height="@dimen/widget_settings_area"
        android:layout_gravity="top|left"
        android:background="@color/widget_tap_area"
        android:visibility="gone"/>
</merge>
