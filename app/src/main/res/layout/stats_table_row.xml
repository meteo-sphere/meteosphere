<?xml version="1.0" encoding="utf-8"?>
<!-- A source in the statistics' table: its colour, its name, its requests today or on the day picked, the most and the fewest a day -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="32dp"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/ivStatsColor"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="10dp"
        android:importantForAccessibility="no"
        android:src="@drawable/stats_dot"/>
    <TextView
        android:id="@+id/tvStatsSource"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurface"/>
    <TextView
        android:id="@+id/tvStatsToday"
        style="@style/StatsNumber"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/tvStatsMax"
        style="@style/StatsNumber"/>
    <TextView
        android:id="@+id/tvStatsMin"
        style="@style/StatsNumber"/>
</LinearLayout>
