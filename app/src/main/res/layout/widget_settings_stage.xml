<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's preview on the home screen's wallpaper, its kinds swiped or picked by the buttons under it -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <org.meteosphere.ui.common.WallpaperWindowView
            android:id="@+id/wallpaperWindow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"/>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/vpWidgetSamples"
            android:layout_width="match_parent"
            android:layout_height="200dp"/>
    </FrameLayout>
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/tgWidgetType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:selectionRequired="true"
        app:singleSelection="true">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTypeFirst"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checkable="true"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTypeSecond"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checkable="true"/>
    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>
