<?xml version="1.0" encoding="utf-8"?>
<!-- The 4x1 weather widget: the weather now at the left, a line, and three hours or days at the right, each with its
     time or day over its icon and temperature -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flWidget"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imvBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/widget_glass_inset"
        android:scaleType="fitXY"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="@dimen/widget_padding"
        android:paddingTop="@dimen/widget_padding"
        android:paddingRight="@dimen/widget_padding"
        android:paddingBottom="@dimen/widget_padding_bottom"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <include
            layout="@layout/widget_now_part"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="45"/>
        <ImageView
            android:id="@+id/imvDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/widget_divider_gap"
            android:layout_marginBottom="@dimen/widget_forecast_bottom"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="55"
            android:paddingBottom="@dimen/widget_forecast_bottom"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvForecastLabel1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="@dimen/widget_forecast_label"/>
                <ImageView
                    android:id="@+id/imvForecastIcon1"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/widget_forecast_icon_gap"
                    android:layout_marginBottom="@dimen/widget_forecast_icon_gap"
                    android:scaleType="center"/>
                <TextView
                    android:id="@+id/tvForecastTemperature1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="@dimen/widget_forecast_temperature"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvForecastLabel2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="@dimen/widget_forecast_label"/>
                <ImageView
                    android:id="@+id/imvForecastIcon2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/widget_forecast_icon_gap"
                    android:layout_marginBottom="@dimen/widget_forecast_icon_gap"
                    android:scaleType="center"/>
                <TextView
                    android:id="@+id/tvForecastTemperature2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="@dimen/widget_forecast_temperature"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvForecastLabel3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="@dimen/widget_forecast_label"/>
                <ImageView
                    android:id="@+id/imvForecastIcon3"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="@dimen/widget_forecast_icon_gap"
                    android:layout_marginBottom="@dimen/widget_forecast_icon_gap"
                    android:scaleType="center"/>
                <TextView
                    android:id="@+id/tvForecastTemperature3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="@dimen/widget_forecast_temperature"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <include layout="@layout/widget_settings_gear"/>
    <FrameLayout
        android:id="@+id/flRefresh"
        android:layout_width="@dimen/widget_refresh_area"
        android:layout_height="@dimen/widget_refresh_area"
        android:layout_gravity="bottom|left"
        android:background="@color/widget_tap_area"/>
</FrameLayout>
