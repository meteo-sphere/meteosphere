<?xml version="1.0" encoding="utf-8"?>
<!-- The weather notification's expanded view with the forecast: the weather now at the left, the place's name under it,
     and the next three hours at the right, each its time, icon and temperature; over the place's sky in the sky look.
     The texts are in dp, so that the system's font size doesn't break the fixed height -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_corners"
    android:clipToOutline="true">
    <ImageView
        android:id="@+id/imvHoursSky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.45">
            <TextView
                android:id="@+id/tvHoursName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:ellipsize="end"
                android:gravity="left"
                android:paddingLeft="5dp"
                android:paddingRight="3dp"
                android:paddingBottom="3dp"
                android:singleLine="true"
                android:textSize="12dp"/>
            <TextView
                android:id="@+id/tvHoursWind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@id/tvHoursName"
                android:ellipsize="end"
                android:gravity="center"
                android:paddingRight="12dp"
                android:singleLine="true"
                android:textSize="12dp"/>
            <!-- Down to the name, over the wind: the temperature's padding keeps it above the wind -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@id/tvHoursName"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/imvHoursIcon"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:paddingLeft="2dp"
                    android:paddingTop="6dp"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:id="@+id/tvHoursTemperature"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingBottom="13dp"
                    android:singleLine="true"
                    android:textSize="34dp"/>
            </LinearLayout>
        </RelativeLayout>
        <ImageView
            android:id="@+id/imvHoursSeparator"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.55"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingTop="4dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:paddingBottom="2dp">
                    <TextView
                        android:id="@+id/tvHour1Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingRight="1dp"
                        android:singleLine="true"
                        android:textSize="12dp"/>
                    <TextView
                        android:id="@+id/tvHour1AmPm"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="top"
                        android:singleLine="true"
                        android:textSize="8dp"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/imvHour1Icon"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:id="@+id/tvHour1Temperature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingBottom="3dp"
                    android:singleLine="true"
                    android:textSize="12dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:paddingBottom="2dp">
                    <TextView
                        android:id="@+id/tvHour2Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingRight="1dp"
                        android:singleLine="true"
                        android:textSize="12dp"/>
                    <TextView
                        android:id="@+id/tvHour2AmPm"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="top"
                        android:singleLine="true"
                        android:textSize="8dp"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/imvHour2Icon"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:id="@+id/tvHour2Temperature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingBottom="3dp"
                    android:singleLine="true"
                    android:textSize="12dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:paddingBottom="2dp">
                    <TextView
                        android:id="@+id/tvHour3Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingRight="1dp"
                        android:singleLine="true"
                        android:textSize="12dp"/>
                    <TextView
                        android:id="@+id/tvHour3AmPm"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="top"
                        android:singleLine="true"
                        android:textSize="8dp"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/imvHour3Icon"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="fitCenter"/>
                <TextView
                    android:id="@+id/tvHour3Temperature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingBottom="3dp"
                    android:singleLine="true"
                    android:textSize="12dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
