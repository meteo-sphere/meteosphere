<?xml version="1.0" encoding="utf-8"?>
<!-- A favourite city as a card of its own sky: the place, its time and weather on the left, the temperature, the wind and
     the day's high and low on the right -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:id="@+id/cityCard"
        android:layout_width="match_parent"
        android:layout_height="@dimen/city_card_height"
        android:background="@drawable/bg_city_card"
        android:foreground="@drawable/fg_details_card_ripple">

        <ImageView
            android:id="@+id/ivCitySky"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <!-- On the light theme a night's sky softened, shown by the adapter -->
        <View
            android:id="@+id/vCityVeil"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/city_card_night_veil"
            android:visibility="gone" />

        <!-- Under the texts, as strong as the sky is bright, see CardSkies -->
        <View
            android:id="@+id/vCityShade"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_city_card_scrim" />

        <!-- Two rows: the name and the time beside the temperature, the weather beside the wind and the day's high
             and low, so that each text gives way only to what is on its own row; held at the top and at the bottom,
             so that the lower one grows up when its weather takes two lines -->
        <!-- Its texts' shadows not cut at their ends: within its padding -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:clipChildren="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCityName"
                        style="@style/DetailsSkyHeaderText"
                        android:layout_width="wrap_content"
                        android:drawablePadding="6dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:textSize="21sp"
                        tools:text="Амстердам" />

                    <TextView
                        android:id="@+id/tvCityTime"
                        style="@style/DetailsSkyHeaderText"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textSize="14sp"
                        tools:text="10:56" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCityTemperature"
                    style="@style/DetailsSkyHeaderText"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="-6dp"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textSize="46sp"
                    tools:text="16°" />
            </LinearLayout>

            <!-- At the bottom: a weather too long for a line takes two, its last one on the line of the wind and the day's
                 high and low; the texts stand 1dp up as the wind's text in its pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:baselineAligned="false"
                android:clipChildren="false"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCityCondition"
                    style="@style/DetailsSkyHeaderText"
                    android:layout_width="0dp"
                    android:layout_marginBottom="1dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textSize="14sp"
                    tools:text="Переменная облачность" />

                <!-- The wind with its icon, shadowed as the other texts on the sky; a strong one on a red pill -->
                <TextView
                    android:id="@+id/tvCityWind"
                    style="@style/DetailsSkyHeaderText"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:drawableStart="@drawable/ic_city_wind"
                    android:drawablePadding="4dp"
                    android:gravity="center"
                    android:paddingStart="7dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="1dp"
                    android:singleLine="true"
                    android:textSize="14sp"
                    tools:text="9 м/с" />

                <!-- As wide as the widest high and low of the list, see the adapter: the pills keep to one column -->
                <TextView
                    android:id="@+id/tvCityHighLow"
                    style="@style/DetailsSkyHeaderText"
                    android:layout_marginBottom="1dp"
                    android:gravity="end"
                    android:singleLine="true"
                    android:textSize="14sp"
                    tools:text="↑ 17° / ↓ 11°" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
