<?xml version="1.0" encoding="utf-8"?>
<!-- Today's moon at the top of the moon tab: its phase and light, its height over the day, moonrise and moonset, its
     age and sign, what comes next, then its light over the month, the next phases, the lunar eclipses and the title of
     the days, each folding away -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="12dp">
    <!-- Today's moon in a card of its own over the sky, under the place and the moment pinned over the tab; the Moon's
         glow at the top of the chart reaches over it -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_astro_hero"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/ivMoonToday"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:contentDescription="@null"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="20dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvMoonPhase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvMoonIllumination"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:background="@drawable/bg_pill"
                        android:textAppearance="?attr/textAppearanceTitleMedium"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="@string/moon_illuminated"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvMoonIlluminationChange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>
        </LinearLayout>
        <org.meteosphere.ui.astro.SunDayChart
            android:id="@+id/moonDayChart"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="12dp"/>
        <LinearLayout
            android:id="@+id/llMoonRiseSet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/ivMoonRise"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="7dp"
                    android:background="@drawable/bg_magnitude"
                    android:src="@drawable/ic_moon_rise"
                    android:contentDescription="@null"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvMoonRise"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="?attr/colorOnSurface"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/moon_rise"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:gravity="end"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvMoonSet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="?attr/colorOnSurface"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/moon_set"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"/>
                </LinearLayout>
                <ImageView
                    android:id="@+id/ivMoonSet"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="7dp"
                    android:background="@drawable/bg_magnitude"
                    android:src="@drawable/ic_moon_set"
                    android:contentDescription="@null"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <include android:id="@+id/tileMoonAge" layout="@layout/item_astro_tile"/>
        <Space
            android:layout_width="10dp"
            android:layout_height="match_parent"/>
        <include android:id="@+id/tileMoonSign" layout="@layout/item_astro_tile"/>
    </LinearLayout>
    <include android:id="@+id/cardMoonNext" layout="@layout/item_sun_next"/>
    <include android:id="@+id/headerMoonMonth" layout="@layout/item_astro_section"/>
    <LinearLayout
        android:id="@+id/llMoonMonth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvMoonSelectedDay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"/>
        <org.meteosphere.ui.astro.MoonMonthChart
            android:id="@+id/moonMonthChart"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
    <include android:id="@+id/headerMoonPhases" layout="@layout/item_astro_section"/>
    <LinearLayout
        android:id="@+id/llNextPhases"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>
    <include android:id="@+id/headerMoonEclipses" layout="@layout/item_astro_section"/>
    <LinearLayout
        android:id="@+id/llMoonEclipses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>
    <include android:id="@+id/headerMoonDays" layout="@layout/item_astro_section"/>
</LinearLayout>
