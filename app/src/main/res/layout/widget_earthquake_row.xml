<?xml version="1.0" encoding="utf-8"?>
<!-- An earthquake in the widget: the magnitude badge, the place and the distance under it, how long ago; the rows share the height -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llQuakeRow"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp">
        <ImageView
            android:id="@+id/imvRowBadge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_magnitude"/>
        <TextView
            android:id="@+id/tvRowMagnitude"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="15sp"
            android:textStyle="bold"/>
    </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="13dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tvRowPlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="16sp"/>
        <TextView
            android:id="@+id/tvRowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textSize="14sp"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tvRowAgo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:minWidth="42dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:gravity="center"
        android:singleLine="true"
        android:textSize="14sp"
        android:textStyle="bold"/>
</LinearLayout>
