<?xml version="1.0" encoding="utf-8"?>
<!-- The earthquakes run up under their place, order and periods, pinned on glass over the top of the tab -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/srlEarthquakes"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvEarthquakes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp"/>
                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="32dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"/>
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </FrameLayout>
    <org.meteosphere.ui.glass.GlassStrip
        android:id="@+id/earthquakesStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="4dp">
        <!-- The place and the order on top, as the Moon's and the Sun's place, the periods under them -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/flEarthquakesPlace"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="invisible">
                <include layout="@layout/view_astro_place"/>
            </FrameLayout>
            <!-- By time or by distance to the place, so only with a place -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgEarthquakesSort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:visibility="gone"
                app:singleSelection="true"
                app:selectionRequired="true">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEarthquakesSortTime"
                    style="@style/Widget.Meteo.QuakeToggle"
                    android:contentDescription="@string/earthquakes_sort_time"
                    app:icon="@drawable/ic_schedule"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEarthquakesSortDistance"
                    style="@style/Widget.Meteo.QuakeToggle"
                    android:contentDescription="@string/earthquakes_sort_distance"
                    app:icon="@drawable/ic_straighten"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.chip.Chip
                android:id="@+id/chipDay"
                style="@style/Widget.Meteo.QuakePeriodChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/earthquakes_period_day"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chipWeek"
                style="@style/Widget.Meteo.QuakePeriodChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/earthquakes_period_week"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chipMonth"
                style="@style/Widget.Meteo.QuakePeriodChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/earthquakes_period_month"/>
        </com.google.android.material.chip.ChipGroup>
    </org.meteosphere.ui.glass.GlassStrip>
</FrameLayout>
