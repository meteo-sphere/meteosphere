<?xml version="1.0" encoding="utf-8"?>
<!-- A settings row's icon: the glyph on a disc of its group's hue -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/settings_icon_red_bg"/>
            <size android:width="40dp" android:height="40dp"/>
        </shape>
    </item>
    <item android:width="22dp" android:height="22dp" android:gravity="center">
        <vector android:width="22dp" android:height="22dp" android:viewportWidth="24" android:viewportHeight="24">
            <path
                android:pathData="M2,12h3l2,-5l3,11l3,-14l3,12l2,-4h4"
                android:strokeColor="@color/settings_icon_red"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:strokeWidth="1.8"/>
        </vector>
    </item>
</layer-list>
