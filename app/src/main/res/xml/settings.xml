<?xml version="1.0" encoding="utf-8"?>
<!-- The settings' main list: the logo, then the rows in their groups. The rows that open a screen name it; the rows
     shown only where they work, the computed summaries and the places offered are set up by SettingsFragment -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <org.meteosphere.ui.settings.LogoPreference
        android:key="logo"
        android:selectable="false"/>
    <PreferenceCategory android:title="@string/pref_category_general">
        <Preference
            android:icon="@drawable/ic_settings_language"
            android:key="@string/key_names_language"
            android:title="@string/pref_language"/>
        <Preference
            android:icon="@drawable/ic_settings_units"
            android:key="@string/key_units_screen"
            android:title="@string/pref_units"
            app:fragment="org.meteosphere.ui.settings.UnitsFragment"/>
        <ListPreference
            android:defaultValue="0"
            android:entries="@array/update_period_names"
            android:entryValues="@array/update_period_values"
            android:icon="@drawable/ic_settings_update"
            android:key="@string/key_refresh_period"
            android:title="@string/pref_update_period"
            app:useSimpleSummaryProvider="true"/>
        <ListPreference
            android:defaultValue="remote"
            android:entries="@array/pref_data_provider_names"
            android:entryValues="@array/pref_data_provider_values"
            android:icon="@drawable/ic_settings_server"
            android:key="@string/key_data_provider"
            android:title="@string/pref_data_provider"
            app:useSimpleSummaryProvider="true"/>
        <ListPreference
            android:defaultValue="open_meteo"
            android:entries="@array/pref_weather_source_names"
            android:entryValues="@array/pref_weather_source_values"
            android:icon="@drawable/ic_settings_forecast"
            android:key="@string/key_weather_source"
            android:title="@string/pref_weather_source"
            app:useSimpleSummaryProvider="true"/>
        <Preference
            android:icon="@drawable/ic_settings_key"
            android:key="@string/key_foreca_key"
            android:title="@string/pref_foreca_key"/>
        <!-- Saved only as the user switches it: the app language's own clock till then, see SettingsFragment -->
        <SwitchPreferenceCompat
            android:icon="@drawable/ic_settings_clock"
            android:key="@string/key_clock_24"
            android:persistent="false"
            android:title="@string/pref_24_hour"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pref_category_display">
        <ListPreference
            android:defaultValue="system"
            android:entries="@array/pref_theme_names"
            android:entryValues="@array/pref_theme_values"
            android:icon="@drawable/ic_settings_theme"
            android:key="@string/key_theme"
            android:title="@string/pref_theme"
            app:useSimpleSummaryProvider="true"/>
        <Preference
            android:icon="@drawable/ic_settings_tabs"
            android:key="@string/key_main_tabs"
            android:title="@string/pref_main_tabs"
            app:fragment="org.meteosphere.ui.settings.MainTabsPreferenceFragment"/>
        <Preference
            android:icon="@drawable/ic_settings_parameters"
            android:key="@string/key_parameters_screen"
            android:title="@string/pref_weather_parameters"
            app:fragment="org.meteosphere.ui.settings.ParametersFragment"/>
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:icon="@drawable/ic_settings_wind"
            android:key="@string/key_wind_when_strong"
            android:title="@string/pref_only_strong_wind"/>
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/ic_settings_live_sky"
            android:key="@string/key_live_sky"
            android:summary="@string/pref_live_sky_summary"
            android:title="@string/pref_live_sky"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pref_category_location">
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/ic_settings_gps"
            android:key="@string/key_search_by_gps"
            android:title="@string/pref_gps"/>
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/ic_settings_location"
            android:key="@string/key_show_current"
            android:title="@string/pref_current_location"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/pref_category_notifications">
        <Preference
            android:icon="@drawable/ic_settings_notification"
            android:key="@string/key_notification_screen"
            android:title="@string/pref_notification"
            app:fragment="org.meteosphere.ui.settings.NotificationSettingsFragment"/>
        <!-- The places it offers are made in code -->
        <ListPreference
            android:defaultValue="0"
            android:icon="@drawable/ic_settings_forecast"
            android:key="@string/key_daily_forecast"
            android:title="@string/pref_daily_forecast"
            app:useSimpleSummaryProvider="true"/>
        <ListPreference
            android:defaultValue="0"
            android:entries="@array/pref_earthquake_alerts_world_names"
            android:entryValues="@array/pref_earthquake_alerts_world_values"
            android:icon="@drawable/ic_settings_earthquakes"
            android:key="@string/key_earthquake_alerts_world"
            android:title="@string/pref_earthquake_alerts_world"
            app:useSimpleSummaryProvider="true"/>
        <ListPreference
            android:defaultValue="0"
            android:entries="@array/pref_earthquake_alerts_nearby_names"
            android:entryValues="@array/pref_earthquake_alerts_nearby_values"
            android:icon="@drawable/ic_settings_nearby"
            android:key="@string/key_earthquake_alerts_nearby"
            android:title="@string/pref_earthquake_alerts_nearby"
            app:useSimpleSummaryProvider="true"/>
        <ListPreference
            android:defaultValue="off"
            android:entries="@array/pref_moon_phase_alerts_names"
            android:entryValues="@array/pref_moon_phase_alerts_values"
            android:icon="@drawable/ic_settings_moon"
            android:key="@string/key_moon_phase_alerts"
            android:title="@string/pref_moon_phase_alerts"
            app:useSimpleSummaryProvider="true"/>
        <ListPreference
            android:defaultValue="off"
            android:entries="@array/pref_eclipse_alerts_names"
            android:entryValues="@array/pref_eclipse_alerts_values"
            android:icon="@drawable/ic_settings_eclipse"
            android:key="@string/key_eclipse_alerts"
            android:title="@string/pref_eclipse_alerts"
            app:useSimpleSummaryProvider="true"/>
    </PreferenceCategory>
    <!-- The add-ons' rows, made in code; hidden without them -->
    <PreferenceCategory
        android:key="@string/key_category_experimental"
        android:title="@string/pref_category_experimental"/>
    <!-- No title: only the gap sets the statistics apart -->
    <PreferenceCategory>
        <Preference
            android:icon="@drawable/ic_settings_statistics"
            android:key="@string/key_statistics"
            android:title="@string/pref_statistics"
            app:fragment="org.meteosphere.ui.settings.StatisticsFragment"/>
    </PreferenceCategory>
</PreferenceScreen>
