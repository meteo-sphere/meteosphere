<?xml version="1.0" encoding="utf-8"?>
<!-- The weather widget 4x2: the weather now with the clock -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="120dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_loading"
    android:previewImage="@drawable/widget_picker_clock"
    android:configure="org.meteosphere.ui.widgets.settings.WeatherWidgetSettingsActivity"
    android:widgetFeatures="reconfigurable"
    android:widgetCategory="home_screen"/>
