<?xml version="1.0" encoding="utf-8"?>
<!-- A settings screen opening grows to its size, fading in once the one it opens from is out of sight -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <set android:ordering="sequentially">
        <objectAnimator
            android:duration="@integer/settings_screen_fade_out"
            android:propertyName="alpha"
            android:valueFrom="0"
            android:valueTo="0" />
        <objectAnimator
            android:duration="@integer/settings_screen_fade_in"
            android:interpolator="@android:anim/linear_interpolator"
            android:propertyName="alpha"
            android:valueFrom="0"
            android:valueTo="1" />
    </set>
    <objectAnimator
        android:duration="@integer/settings_screen_change"
        android:interpolator="?attr/motionEasingEmphasizedInterpolator"
        android:propertyName="scaleX"
        android:valueFrom="0.8"
        android:valueTo="1" />
    <objectAnimator
        android:duration="@integer/settings_screen_change"
        android:interpolator="?attr/motionEasingEmphasizedInterpolator"
        android:propertyName="scaleY"
        android:valueFrom="0.8"
        android:valueTo="1" />
</set>
