<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The Moon and Sun tabs drawn over their sky: always the dark theme's colours with white text, translucent cards
         rounded as the city details' ones. Applied with a night configuration, see SkyTheme. -->
    <style name="ThemeOverlay.Meteo.SkyNight" parent="">
        <!-- The chips draw it under themselves: they are veiled as the cards -->
        <item name="colorSurface">#1FFFFFFF</item>
        <item name="colorSurfaceContainerHighest">#1FFFFFFF</item>
        <item name="colorSurfaceContainerHigh">#1AFFFFFF</item>
        <item name="colorSurfaceContainer">#14FFFFFF</item>
        <item name="colorSurfaceContainerLow">#0FFFFFFF</item>
        <item name="colorOnSurface">#FFFFFFFF</item>
        <item name="colorOnSurfaceVariant">#C7FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#C7FFFFFF</item>
        <item name="colorOutline">#73FFFFFF</item>
        <item name="colorOutlineVariant">#33FFFFFF</item>
        <item name="colorPrimary">#FFFFFFFF</item>
        <item name="colorSecondaryContainer">#2EFFFFFF</item>
        <item name="colorOnSecondaryContainer">#FFFFFFFF</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Meteo.SkyCard</item>
    </style>

    <!-- The pictures of the Sun on black: the sky's dark theme with the Sun's amber for what is picked and played -->
    <style name="ThemeOverlay.Meteo.SunNow" parent="ThemeOverlay.Meteo.SkyNight">
        <item name="colorPrimary">#FFFFB300</item>
        <item name="colorOnPrimary">#FF3F2800</item>
        <item name="colorSecondaryContainer">#FF4A3500</item>
        <item name="colorOnSecondaryContainer">#FFFFDF9E</item>
    </style>

    <!-- Over the day sky the cards are a dark blue veil, as the city details' by day -->
    <style name="ThemeOverlay.Meteo.SkyDay" parent="ThemeOverlay.Meteo.SkyNight">
        <item name="colorSurface">#4D1E3044</item>
        <item name="colorSurfaceContainerHighest">#4D1E3044</item>
        <item name="colorSurfaceContainerHigh">#401E3044</item>
        <item name="colorSurfaceContainer">#331E3044</item>
        <item name="colorSurfaceContainerLow">#261E3044</item>
        <item name="colorSecondaryContainer">#4D1E3044</item>
    </style>

    <style name="ShapeAppearance.Meteo.SkyCard" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
</resources>
